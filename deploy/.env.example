# AWS CLI credentials stay in this profile. Run commands from WSL/Linux.
AWS_PROFILE=outbox-lab
AWS_REGION=eu-central-1

# Your public IPv4 address followed by /32.
TF_VAR_allowed_client_cidr=

# Ansible control node (WSL/Linux).
# Set this to a Python 3.11+ executable if python3 is older.
PYTHON=python3
ANSIBLE_PRIVATE_KEY_FILE=${HOME}/.ssh/id_rsa

# Desired ECS task counts across all application hosts.
ORDERS_REPLICAS=4
PAYMENT_REPLICAS=4

# Required for build and deploy; use the same tag for both, e.g. test-001.
IMAGE_TAG=

# make setup fills empty passwords. Keep them for subsequent deployments.
ORDERS_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
