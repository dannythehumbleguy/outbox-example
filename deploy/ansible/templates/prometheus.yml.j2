global:
  scrape_interval: 15s
scrape_configs:
  - job_name: orders-api
    metrics_path: /orders/metrics
    dns_sd_configs:
      - names: [orders.{{ discovery_domain }}]
        type: SRV
        refresh_interval: 15s
  - job_name: payment-api
    metrics_path: /payments/metrics
    dns_sd_configs:
      - names: [payment.{{ discovery_domain }}]
        type: SRV
        refresh_interval: 15s
  - job_name: nodes
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host].private_ip }}:9100']
        labels:
          host: {{ host }}
{% endfor %}
  - job_name: kafka-exporter
    static_configs:
      - targets: ['kafka-exporter:9308']
