      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"nodes\",host=~\"orders-db|payment-db\",mountpoint=~\"/|/data\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"nodes\",host=~\"orders-db|payment-db\",mountpoint=~\"/|/data\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{host}} {{mountpoint}}",
