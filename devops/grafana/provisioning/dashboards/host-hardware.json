        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (host) (rate(node_network_receive_bytes_total{job=\"nodes\",host=~\"orders-db|payment-db\",device=~\"(eth|en[opsx]).*\"}[$__rate_interval]))",
          "legendFormat": "{{host}} receive",
          "refId": "A"
        },
        {
          "expr": "sum by (host) (rate(node_network_transmit_bytes_total{job=\"nodes\",host=~\"orders-db|payment-db\",device=~\"(eth|en[opsx]).*\"}[$__rate_interval]))",
