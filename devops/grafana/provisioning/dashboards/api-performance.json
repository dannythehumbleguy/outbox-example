{
  "uid": "api-performance",
  "title": "API Performance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["performance", "api"],
  "panels": [
    {
      "id": 1,
      "title": "Avg Request Duration by Endpoint (ms)",
      "type": "timeseries",
      "interval": "20s",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg_over_time({app=\"order-service\"} | json | RequestPath=~`(?i)/api/.*` | label_format RequestPath=`{{ .RequestPath | lower }}` | unwrap Elapsed [$__interval]) by (RequestMethod, RequestPath)",
          "legendFormat": "{{RequestMethod}} {{RequestPath}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["min", "mean", "max", "last"]
        }
      }
    },
    {
      "id": 2,
      "title": "Outbox → Kafka Publish Latency (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(outbox_publish_latency_seconds_sum[$__rate_interval]) / rate(outbox_publish_latency_seconds_count[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["min", "mean", "max", "last"]
        }
      }
    },
    {
      "id": 3,
      "title": "Outbox → Consumer Handled Latency (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(outbox_consumer_latency_seconds_sum[$__rate_interval]) / rate(outbox_consumer_latency_seconds_count[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["min", "mean", "max", "last"]
        }
      }
    },
    {
      "id": 5,
      "title": "Order Creation Requests per Second",
      "description": "Requests reaching the order creation controller, summed across all OrderService replicas.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(order_create_requests_total[$__rate_interval]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Order Creation to Payment Processing",
      "description": "Time from the incoming HTTP request to successful processing in PaymentService, including outbox and Kafka. Requires synchronized host clocks.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 30 },
      "targets": [
        { "expr": "sum(rate(order_processing_latency_seconds_sum[$__rate_interval])) / sum(rate(order_processing_latency_seconds_count[$__rate_interval]))", "legendFormat": "average", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(order_processing_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Application Database Connections",
      "description": "Npgsql connections from application instances to PgBouncer, grouped by service and pool state. The limit is summed across the running instances.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "sum by (job, db_client_connection_state) (npgsql_db_client_connection_count{job=~\"orders-api|payment-api\"})",
          "legendFormat": "{{job}} / {{db_client_connection_state}}",
          "refId": "A"
        },
        {
          "expr": "sum by (job) (npgsql_db_client_connection_max{job=~\"orders-api|payment-api\"})",
          "legendFormat": "{{job}} / pool limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 4,
      "title": "Kafka Consumer Lag by Partition",
      "description": "Approximate offset lag for the payment-service consumer group on order-events. Data appears after offsets are committed.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kafka_consumergroup_lag{topic=\"order-events\",consumergroup=\"payment-service\"} >= 0",
          "legendFormat": "{{topic}} / {{consumergroup}} / partition {{partition}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["min", "mean", "max", "last"] }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  }
}
